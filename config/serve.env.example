# Service settings for scripts/serve.sh. Copy to config/serve.env and edit; serve.sh reads config/serve.env
# (or the file given with --config). Plain shell assignments; leave a value empty for its default.

# Models (see README: an FP8 Qwen3.8-27B checkpoint with its MTP weights, and the matching DFlash2 drafter)
TARGET_MODEL=/models/qwen3.8-27b-fp8-mtp
DRAFT_MODEL=/models/Qwen3.8-27B-DFlash2
SERVED_MODEL_NAME=qwen3.8-27b-fp8-mtp

# API endpoint. 127.0.0.1 keeps it local; use 0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=8000
# Optional bearer token for the OpenAI API (vLLM --api-key). Empty = no authentication.
API_KEY=

# Context and concurrency. The tuned buckets assume these values; see docs/CONFIG.md before changing them.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
# KV cache (FP8). 28 GiB holds about 527K tokens, i.e. two full-length requests.
KV_CACHE_GIB=28

# Pin the engine thread to one CPU after warm-up (an idle physical core; its hyperthread sibling is kept free too).
# Worth about 0.3 ms per decode round. Empty = no pinning.
PIN_MAIN_CPU=

# Where compile caches, logs and runtime control files go.
DATA_DIR=$HOME/.cache/gaudi2-single-card-vllm

# Default sampling when a request does not set it (the model card's recommended values).
GENERATION_CONFIG='{"temperature":1.0,"top_p":0.95,"top_k":20}'
