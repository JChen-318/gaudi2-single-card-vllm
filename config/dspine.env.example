# Qwen3.8-27B DSpine BF16 draft, isolated text-only decode configuration.
TARGET_MODEL=/mnt/sas/models/qwen3.8-27b-fp8-mtp
DRAFT_MODEL=/mnt/sas/models/Qwen3.8-27B-DSpine-b16
SERVED_MODEL_NAME=qwen3.8-27b-dspine
HOST=127.0.0.1
PORT=8016
DTYPE=auto
NUM_SPECULATIVE_TOKENS=15
# Host pipelining and the wider T=1 correction that the block needs (docs/DSPINE.md).
DSPINE=1
# From this context length on, rounds verify 8 tokens instead of 16 (0 = always 16). Only matters
# when MAX_MODEL_LEN exceeds it; production serves 262K with the default 32768.
DSPINE_DYNAMIC_WIDTH=32768
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=2
KV_CACHE_GIB=8
DATA_DIR=/home/a/dspine-gaudi/data
VISION=0
PREFIX_CACHE=0
DECODE_KV_MIRROR_PAGES=0
PRIME_AFTER_START=0
SPEC_FAST_PATHS=1
GENERATION_CONFIG='{"temperature":1.0,"top_p":0.95,"top_k":20}'
