# cp docker/docker.env.example docker/docker.env, edit, then:
#   docker compose -f docker/compose.yaml --env-file docker/docker.env up -d
# Absolute paths on the host.

# The service configuration (same file scripts/serve.sh reads; see docs/CONFIG.md).
SERVE_ENV=/path/to/gaudi2-single-card-vllm/config/serve.env
# A directory that contains both TARGET_MODEL and DRAFT_MODEL from serve.env (mounted read-only, same path).
# For a network share mounted on demand, give its mount point: the container waits for the model files
# (MODEL_WAIT_SECONDS in serve.env, default 1800) instead of failing when the share comes up after Docker.
MODEL_ROOT=/path/to/models
# Must equal DATA_DIR in serve.env: compile caches (keep them: they cut later starts from ~45 to ~35 minutes),
# logs and runtime control files.
DATA_DIR=/path/to/gsv-data

# Image name to build / run.
IMAGE=gaudi2-single-card-vllm:latest
CONTAINER_NAME=gaudi2-vllm
# Gaudi device nodes (ls /dev/accel; the card's RDMA device: ls -l /dev/infiniband/by-ibdev, uverbs-hbl_N).
ACCEL_DEVICE=/dev/accel/accel0
ACCEL_CONTROL_DEVICE=/dev/accel/accel_controlD0
UVERBS_DEVICE=/dev/infiniband/uverbs0
# Package sources used while building the image (a nearby mirror speeds it up), e.g.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple  APT_MIRROR=https://mirrors.aliyun.com/ubuntu
PIP_INDEX_URL=https://pypi.org/simple
APT_MIRROR=
